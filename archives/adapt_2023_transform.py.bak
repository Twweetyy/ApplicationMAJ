# adapt_2023_transform.py
"""
Script de transformation des jeux de données 2023 pour le projet ApplicationMAJ.
Il charge chaque jeu CSV source, filtre les IRIS de Roubaix selon le fichier
`dictionnaires/grand_quartier.yml`, pivote les variables d'intérêt et renomme les
colonnes à l'aide des dictionnaires YML générés précédemment.
Le résultat est écrit dans `data/data2023/` avec le même nom de fichier que les
jeux 2022 (préfixe `base-ic-<theme>-2023.CSV`).
"""

import os
import pandas as pd
import yaml

# ---------------------------------------------------------------------------
# Configuration des chemins
# ---------------------------------------------------------------------------
PROJECT_ROOT = os.path.abspath(os.path.dirname(__file__))
DATA_DIR = os.path.join(PROJECT_ROOT, "data")
DICT_DIR = os.path.join(PROJECT_ROOT, "dictionnaires")
META_DIR = os.path.join(DICT_DIR, "meta", "meta2023")

# Chargement du fichier contenant la liste exhaustive des codes IRIS de Roubaix
GRAND_QUARTIER_PATH = os.path.join(DICT_DIR, "grand_quartier.yml")
with open(GRAND_QUARTIER_PATH, "r", encoding="utf-8") as f:
    GRAND_QUARTIER = yaml.safe_load(f)
# On ne garde que les clés (codes) sous forme de chaîne
ALLOWED_GEO = {str(k) for k in GRAND_QUARTIER.keys()}

# Mapping thème → fichier source CSV (sans chemin)
THEMES = {
    "POP": "base-ic-pop-2023.csv",
    "LOG": "base-ic-log-2023.csv",
    "DIP": "base-ic-dip-2023.csv",
}


# Chargement des dictionnaires de libellés pour chaque thème
DICT_FILES = {
    name: yaml.safe_load(
        open(os.path.join(DICT_DIR, f"dictionnaire_variables_{name}.yml"), "r", encoding="utf-8")
    )
    for name in ["POP", "LOG", "DIP"]
}

# Répertoire de sortie des CSV pivotés
OUTPUT_DIR = os.path.join(DATA_DIR, "data2023")
os.makedirs(OUTPUT_DIR, exist_ok=True)

for theme, src_name in THEMES.items():
    csv_path = os.path.join(DATA_DIR, "data2023", "sources_brutes_insee", src_name)
    if not os.path.isfile(csv_path):
        print(f"[WARN] {csv_path} introuvable, on passe.")
        continue

    # Lecture sélective – on ne garde que les colonnes utiles
    df = pd.read_csv(csv_path, sep=";", encoding="utf-8-sig", low_memory=False)

    # Filtrage strict sur les codes IRIS de Roubaix
    df = df[df["GEO"].astype(str).isin(ALLOWED_GEO)]
    if df.empty:
        print(f"[WARN] Aucun enregistrement pour les IRIS Roubaix dans {csv_path}.")
        continue

    # Renommage des colonnes à l'aide du dictionnaire YML du thème
    mapping = DICT_FILES[theme]
    new_cols = {col: mapping.get(col, col) for col in df.columns}
    df.rename(columns=new_cols, inplace=True)

    # Export CSV compatible avec le reste du pipeline
    out_path = os.path.join(OUTPUT_DIR, f"base-ic-{theme.lower()}-2023.CSV")
    df.to_csv(out_path, sep=";", encoding="utf-8", index=False)
    print(f"[OK] {out_path} généré ({df.shape[0]} lignes, {df.shape[1]} colonnes)")

print("Transformation terminée.")
