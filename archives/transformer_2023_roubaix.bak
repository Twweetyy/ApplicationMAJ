        "P23_H5564": {"AGE": "Y55T64", "SEX": "M"},
        "P23_F1564": {"AGE": "Y15T64", "SEX": "F"},
        "P23_F1524": {"AGE": "Y15T24", "SEX": "F"},
        "P23_F2554": {"AGE": "Y25T54", "SEX": "F"},
        "P23_F5564": {"AGE": "Y55T64", "SEX": "F"},
