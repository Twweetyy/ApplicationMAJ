# Copier ce fichier en .env et renseigner les valeurs (.env n'est jamais versionné).
# Fournisseur compatible OpenAI : Groq, OpenAI ou Ollama (local, sans clé).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# Module colonnes inconnues (modules/colonnes_auto.py)
# BDDMAS_LLM=0 désactive l'IA (seule la correspondance sans IA s'applique)
BDDMAS_LLM=0
# Confiance minimale pour appliquer une décision de l'IA (0 à 1)
BDDMAS_LLM_CONFIANCE_MIN=0.8
